# 复制为 .env。密钥不要提交。

AUTODL_MOCK=true
AUTODL_ALLOW_POWER=false
AUTODL_TOKEN=
AUTODL_INSTANCE_UUID=
AUTODL_API_BASE=https://api.autodl.com
ORCH_BASE=http://127.0.0.1:8090
COMFYUI_ENDPOINT=http://127.0.0.1:8188
LLM_BASE_URL=http://127.0.0.1:8088
COMFYUI_SSH_HOST=connect.westd.seetacloud.com
COMFYUI_SSH_PORT=
COMFYUI_SSH_USER=root
# 密码用 sshpass -e，勿提交。也可用 SSH 密钥 + BatchMode
# COMFYUI_SSH_PASSWORD=
LOG_LEVEL=INFO
