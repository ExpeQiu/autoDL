# 复制为 .env 后按需修改。密钥与 SSH 密码不要提交。

# 图/视频：false 时视频走 ComfyUI H3；本卡无文生图时保持 AI_MOCK_IMAGE=true
AI_MOCK_MODE=true
AI_MOCK_TEXT=true
AI_MOCK_IMAGE=true
ORCH_HOST=127.0.0.1
ORCH_PORT=8090
LOG_LEVEL=INFO

# 隧道映射后的本机地址，禁止写 AutoDL 公网 IP
COMFYUI_ENDPOINT=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=1800000
COMFYUI_POLL_INTERVAL_MS=3000
COMFYUI_VIDEO_WIDTH=768
COMFYUI_VIDEO_HEIGHT=768
COMFYUI_VIDEO_LENGTH=73
COMFYUI_VIDEO_STEPS=4
COMFYUI_SSH_HOST=connect.westd.seetacloud.com
COMFYUI_SSH_PORT=
COMFYUI_SSH_USER=root

# llama.cpp OpenAI 兼容（隧道后）
LLM_BASE_URL=http://127.0.0.1:8088
LLM_API_KEY=sk-local
LLM_MODEL=qwen3.8-27b
LLM_LOCAL_PORT=8088
LLM_REMOTE_PORT=8088

# 产物与库
ARTIFACTS_DIR=./artifacts
SQLITE_PATH=./data/jobs.sqlite

# 前端
WEB_PORT=3190
